# Local dev: `docker compose up -d` starts a matching Postgres on this URL.
# Production (Vercel): use the connection string from your hosted Postgres (Vercel Postgres, Neon, Supabase, etc).
DATABASE_URL="postgresql://postgres:devpass@localhost:5434/sirah_trading"
AUTH_SECRET="replace-with-output-of: openssl rand -base64 32"
# Optional bootstrap fallback: a super admin can instead (and preferably) set the OpenAI key
# from Settings -> Platform in the app, where it's stored encrypted. This env var is only used
# when no key has been configured there yet.
OPENAI_API_KEY=""
# Optional: defaults to gpt-4o.
OPENAI_MODEL=""
